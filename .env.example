# Database Configuration
# Local (Postgres in Docker): postgresql+psycopg://postgres:change-me@localhost:5432/odiya_news
# Inside Docker (API to Postgres): postgresql+psycopg://postgres:change-me@postgres:5432/odiya_news
DATABASE_URL=

# Redis Configuration (Used for rotation state)
# Local (Redis in Docker): redis://localhost:6379/0
# Inside Docker (API to Redis): redis://redis:6379/0
REDIS_URL=

# OpenRouter Configuration (AI Summarization)
OPENROUTER_API_KEY=

# Security
JWT_SECRET_KEY=

# Firebase Configuration (Notifications)
FIREBASE_CREDENTIALS_JSON=
